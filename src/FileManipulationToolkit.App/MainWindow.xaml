<Window x:Class="FileManipulationToolkit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileManipulationToolkit.App"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="720" Width="1200" MinWidth="980" MinHeight="600">
    <DockPanel>
        <Border DockPanel.Dock="Left" Width="220" Background="#F3F3F3" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0">
            <StackPanel Margin="12">
                <TextBlock Text="File Manipulation Toolkit" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                <Button Content="Dashboard" Height="36" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="12,0"/>
                <Button Content="Backup" Height="36" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="12,0"/>
                <Button Content="File Tools" Height="36" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="12,0"/>
                <Button Content="Compare" Height="36" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="12,0"/>
                <Button Content="Archive" Height="36" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="12,0"/>
                <Button Content="Analyze" Height="36" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="12,0"/>
                <Button Content="Scheduler" Height="36" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="12,0"/>
                <Button Content="Logs" Height="36" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="12,0"/>
                <Button Content="Settings" Height="36" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="12,0"/>
            </StackPanel>
        </Border>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#D9D9D9" BorderThickness="1" Padding="16" CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="Rolling Backup" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="Phase 1 foundation" Foreground="#555555" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Margin="0,20,0,20" Background="#FAFAFA" BorderBrush="#D9D9D9" BorderThickness="1" Padding="16" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Backup jobs" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <DataGrid Grid.Row="1" AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True" CanUserAddRows="False" Margin="0,0,0,16">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="Source" Width="2*" Binding="{Binding SourceFolder}"/>
                            <DataGridTextColumn Header="Destination" Width="2*" Binding="{Binding BackupFolder}"/>
                            <DataGridTextColumn Header="Enabled" Width="80" Binding="{Binding Enabled}"/>
                            <DataGridTextColumn Header="Mode" Width="120" Binding="{Binding OperationModeOverride}"/>
                            <DataGridTextColumn Header="Retention" Width="90" Binding="{Binding RetentionCountOverride}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="Add Job" Width="100" Height="32" Margin="0,0,8,0"/>
                        <Button Content="Edit" Width="100" Height="32" Margin="0,0,8,0"/>
                        <Button Content="Delete" Width="100" Height="32" Margin="0,0,8,0"/>
                        <Button Content="Run Backup" Width="120" Height="32"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="#F8F8F8" BorderBrush="#D9D9D9" BorderThickness="1" Padding="12" CornerRadius="6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Status:" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <TextBlock Text="Ready" Foreground="#2B7A2B"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
